# Slim Jetson runtime for the fall-detection app.
#
# Design: L4T r36.x userspace IS Ubuntu 22.04, so a plain ubuntu:22.04 base is
# ABI-compatible with the host's CUDA / TensorRT / OpenCV / GStreamer stack.
# Nothing GPU-related is installed in the image; docker-compose.slim.yml
# bind-mounts the host's libraries read-only and they stay authoritative.
#
# libjetson_fall_trt.so is built NATIVELY on the device (see README / the
# cmake invocation below) and only copied in here, so no CUDA devel image and
# no nvcc are needed at image build time:
#   export PATH=/usr/local/cuda/bin:$PATH
#   cmake -S . -B build-slim -DBUILD_APP=ON -DBUILD_TESTING=OFF -DCMAKE_BUILD_TYPE=Release
#   cmake --build build-slim -j2 --target jetson_fall_trt
ARG RUNTIME_IMAGE=docker.m.daocloud.io/library/ubuntu:22.04
FROM ${RUNTIME_IMAGE}

ARG DEBIAN_FRONTEND=noninteractive
RUN apt-get update && apt-get install -y --no-install-recommends \
        python3 \
        python3-numpy \
        python3-paho-mqtt \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app
ARG NATIVE_LIB=build-slim/libjetson_fall_trt.so
COPY ${NATIVE_LIB} /app/libjetson_fall_trt.so
COPY app.py /app/app.py
COPY config/config.json /app/config/config.json
COPY config/config.schema.json /app/config/config.schema.json

# cv2, OpenCV/GStreamer/TensorRT/CUDA shared objects all arrive from the host
# through the compose mounts; see docker-compose.slim.yml.
ENV PYTHONUNBUFFERED=1
ENTRYPOINT ["python3", "/app/app.py"]
